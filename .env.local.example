# Copia este archivo como .env.local y rellena con los valores reales
# de tu proyecto Supabase (Project Settings > API).
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo para uso en el servidor (Server Actions, Edge Functions, scripts
# administrativos). Tiene permisos totales y bypasea RLS: nunca debe
# exponerse al navegador ni tener el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Configuración de calendario hebreo (debe coincidir con configuracion.hebcal_israel en BD)
NEXT_PUBLIC_HEBCAL_ISRAEL=false
